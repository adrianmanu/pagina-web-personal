# Copia este archivo a .env en la raíz de projects/inventory-api/
# y completa con tus datos reales. NO subas .env a git.
#
# Plan recomendado para pruebas: Datil Lite mensual (~$8/mes) — misma API que Mini/Plus.
# Guía paso a paso: SETUP-DATIL-LITE.md

# Activar facturación electrónica SRI
DATIL_ENABLED=true

# Cuenta Datil → Configuración → API (https://app.datil.co)
DATIL_API_KEY=tu-api-key-de-datil

# Contraseña del certificado de firma electrónica (.p12)
DATIL_CERTIFICATE_PASSWORD=clave-de-tu-firma

# 1 = pruebas SRI | 2 = producción
DATIL_AMBIENTE=1

# Datos del emisor (tu RUC)
DATIL_RUC=0999999999001
DATIL_RAZON_SOCIAL=TU RAZON SOCIAL
DATIL_NOMBRE_COMERCIAL=TU MARCA
DATIL_DIRECCION=Tu dirección matriz
DATIL_OBLIGADO_CONTABILIDAD=false
DATIL_CONTRIBUYENTE_ESPECIAL=

# Establecimiento y punto de emisión (configurados en SRI / Datil)
DATIL_ESTABLECIMIENTO=001
DATIL_PUNTO_EMISION=002
DATIL_ESTABLECIMIENTO_DIRECCION=Tu dirección del local

# Último secuencial ya emitido en Datil (siguiente = este + 1)
DATIL_SECUENCIAL_INICIAL=0

# IVA Ecuador 15% (código SRI = 4)
DATIL_IVA_RATE=15
DATIL_IVA_CODIGO=4

# true = los precios en productos ya incluyen IVA
DATIL_PRICES_INCLUDE_IVA=true

# JWT del backend
APP_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
