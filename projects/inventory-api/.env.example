# Copia a .env y completa (nunca subas .env a git)
# cp .env.example .env

# ─── JWT (obligatorio en producción) ───
APP_JWT_SECRET=cambiar-por-secreto-largo-minimo-32-caracteres

# ─── Base de datos (producción: Postgres en Render/Railway) ───
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/stockflow
# SPRING_DATASOURCE_USERNAME=stockflow
# SPRING_DATASOURCE_PASSWORD=secret

# ─── Motor SRI ───
# factuplan (recomendado SaaS) | datil (legacy)
SRI_PROVIDER=factuplan

# Factuplan — modo pruebas: clave ak_test_... (sin P12 obligatorio)
FACTUPLAN_ENABLED=true
FACTUPLAN_API_KEY=ak_test_tu_clave_aqui
FACTUPLAN_API_URL=https://api-rest.factuplan.com.ec
FACTUPLAN_WEBHOOK_SECRET=

# Datil (opcional / legacy)
DATIL_ENABLED=false
DATIL_API_KEY=
DATIL_CERTIFICATE_PASSWORD=
DATIL_AMBIENTE=1
DATIL_RUC=
DATIL_RAZON_SOCIAL=
DATIL_ESTABLECIMIENTO=001
DATIL_PUNTO_EMISION=002

# ─── Membresía ───
# En servidor de pruebas: false para no bloquear emisión SRI
MEMBERSHIP_ENFORCEMENT=false
MEMBERSHIP_TRIAL_DAYS=14

# PayPhone — cobro membresías Ecuador
PAYPHONE_ENABLED=true
PAYPHONE_TOKEN=tu_token_credenciales_payphone
PAYPHONE_STORE_ID=tu-store-id-uuid
# URL pública donde vuelve el usuario tras pagar (frontend en producción)
PAYPHONE_RESPONSE_URL=https://tu-dominio.com/apps/stockflow-live/membresia

# Stripe (opcional; Ecuador usa PayPhone)
STRIPE_ENABLED=false

# ─── Servidor de pruebas ───
# Crea usuario demo@stockflow.dev / demo1234 al arrancar (solo staging)
STOCKFLOW_SEED_DEMO=true
