# Modo portafolio (GitHub Pages / Cloudflare): NO definir VITE_USE_LIVE_API
# → datos demo en el navegador, sin backend

# Modo servidor (API real en producción/staging):
VITE_USE_LIVE_API=true
# URL del backend desplegado (sin barra final)
VITE_API_BASE_URL=https://tu-api.onrender.com

# Solo para build estático con subruta (CI lo define automáticamente)
# VITE_BASE_PATH=/pagina-web-personal/apps/inventory-api/
